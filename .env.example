# ==============================================================================
# Diabetic Retinopathy CDSS — Environment Configuration Template
# ==============================================================================

# Application General
APP_NAME="Diabetic Retinopathy CDSS"
APP_ENV=development
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"

# CORS Configuration (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & JWT Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=dr_user
POSTGRES_PASSWORD=dr_secure_password_2026
POSTGRES_DB=dr_cdss_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL (AsyncPG driver for FastAPI, standard for migrations)
DATABASE_URL="postgresql+asyncpg://dr_user:dr_secure_password_2026@db:5432/dr_cdss_db"
DATABASE_URL_SYNC="postgresql://dr_user:dr_secure_password_2026@db:5432/dr_cdss_db"

# Storage Configuration (Private storage volumes)
STORAGE_BASE_PATH="/app/storage"
STORAGE_IMAGES_PATH="/app/storage/images"
STORAGE_REPORTS_PATH="/app/storage/reports"
STORAGE_ATTRIBUTIONS_PATH="/app/storage/attributions"
MAX_UPLOAD_SIZE_MB=15

# Technical Quality Validation Thresholds (Gates 1 - 3)
MIN_IMAGE_DIMENSION=512
LAPLACIAN_BLUR_THRESHOLD=60.0
CONTRAST_THRESHOLD=18.0
ILLUMINATION_EXTREME_RATIO_MAX=0.35
RETINAL_MIN_COVERAGE=0.20
RETINAL_MAX_COVERAGE=0.98
RETINAL_RED_RATIO_MIN=1.15

# AI Model Configuration (EfficientNet-B0 checkpoint)
MODEL_CHECKPOINT_PATH="/app/models/checkpoints/efficientnet_b0_dr.pth"
MODEL_DEVICE=cpu
MODEL_SCORE_THRESHOLD=0.5

# Frontend Configuration (Vite)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_PORT=3000
