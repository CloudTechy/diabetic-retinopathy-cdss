# ==============================================================================
# Diabetic Retinopathy CDSS — Environment Configuration Template
# ==============================================================================

# Application General
APP_NAME="Diabetic Retinopathy CDSS"
APP_ENV=development
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"

# CORS Configuration (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & JWT Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=dr_user
POSTGRES_PASSWORD=dr_secure_password_2026
POSTGRES_DB=dr_cdss_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL (AsyncPG driver for FastAPI, standard for migrations)
DATABASE_URL="postgresql+asyncpg://dr_user:dr_secure_password_2026@db:5432/dr_cdss_db"
DATABASE_URL_SYNC="postgresql://dr_user:dr_secure_password_2026@db:5432/dr_cdss_db"

# Storage Configuration (Private storage volumes)
STORAGE_BASE_PATH="/app/storage"
STORAGE_IMAGES_PATH="/app/storage/images"
STORAGE_REPORTS_PATH="/app/storage/reports"
STORAGE_ATTRIBUTIONS_PATH="/app/storage/attributions"
MAX_UPLOAD_SIZE_MB=15

# Technical Quality Validation Thresholds (Gates 1 - 3)
# These are the CALIBRATED values (1st percentile over the 2,979 train+val
# images; see docs/chapter4/validation_module_spec.md). An earlier template
# carried the a-priori values 512 / 60.0 / 18.0, which rejected 99.5% of
# genuine images; because settings read the environment, that template
# could silently restore the defect. A rule in the suite keeps this file
# equal to config.py.
MIN_IMAGE_DIMENSION=480
LAPLACIAN_BLUR_THRESHOLD=4.3
CONTRAST_THRESHOLD=8.8
ILLUMINATION_EXTREME_RATIO_MAX=0.35
ILLUMINATION_UNDEREXPOSED_BELOW=25.0
ILLUMINATION_OVEREXPOSED_ABOVE=235.0
RETINAL_MIN_COVERAGE=0.20
RETINAL_RED_RATIO_MIN=1.15
RETINAL_RED_SHARE_MIN=0.36

# AI Model Configuration (EfficientNet-B0 checkpoint)
# Longest side for Gate 2/3 distribution statistics. 0 = full resolution.
VALIDATION_ANALYSIS_MAX_DIM=512

MODEL_CHECKPOINT_PATH="/app/models/weights/efficientnet_b0_dr.pth"
# SHA-256 of the evaluated checkpoint. REQUIRED: the engine refuses to serve if
# this is blank or does not match the file on disk.
MODEL_CHECKPOINT_SHA256="67d0b89641f08057126dd411e380b25575ef29f71ae37ee5796d472d9203dbf7"
# Set to "mock" ONLY for interface development. Serves simulated grades.
AI_INFERENCE_ENGINE="pytorch"
MODEL_DEVICE=cpu

# Frontend Configuration (Vite)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_PORT=3000
