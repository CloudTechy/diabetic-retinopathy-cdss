# ==============================================================================
# Diabetic Retinopathy CDSS - Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & App Configuration
# ------------------------------------------------------------------------------
APP_NAME="Diabetic Retinopathy CDSS"
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
HOST_PORT=3350

# ------------------------------------------------------------------------------
# 2. Security & Authentication (MUST CHANGE SECRET_KEY)
# ------------------------------------------------------------------------------
# Generate a secure key (e.g., `openssl rand -hex 32`)
SECRET_KEY=replace-this-with-a-secure-random-secret-key-for-production
CORS_ORIGINS='["https://drai-cdss.spacehubtech.cloud", "https://frontend-six-psi-77.vercel.app", "http://localhost:3000", "capacitor://localhost", "http://localhost"]'

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=dr_prod_user
POSTGRES_PASSWORD=dr_secure_prod_password_2026_CHANGE_ME
POSTGRES_DB=dr_cdss_prod_db

# ------------------------------------------------------------------------------
# 4. Storage & Model Paths
# ------------------------------------------------------------------------------
STORAGE_BASE_PATH=/app/storage
STORAGE_IMAGES_PATH=/app/storage/images
STORAGE_REPORTS_PATH=/app/storage/reports
STORAGE_ATTRIBUTIONS_PATH=/app/storage/attributions
MAX_UPLOAD_SIZE_MB=15
MODEL_CHECKPOINT_PATH=/app/models/weights/efficientnet_b0_dr.pth
MODEL_CHECKPOINT_SHA256=67d0b89641f08057126dd411e380b25575ef29f71ae37ee5796d472d9203dbf7
MODEL_DEVICE=cpu
